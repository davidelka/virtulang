# Copy to .env. With no API key the server runs in mock mode (keyword replies, no cost).

# --- Gemini (Google AI Studio key) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used once if the main model is overloaded; leave empty to disable
GEMINI_BACKUP_MODEL=gemini-3.5-flash

# --- Claude (Anthropic Console key) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Which provider to use when both keys are set: claude | gemini
# AI_PROVIDER=gemini
# AI_MOCK=1   # force mock mode even when a key is set

PORT=8787
ALLOWED_ORIGIN=http://localhost:5173
